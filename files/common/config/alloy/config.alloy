// 1. Define the shared destination (Loki)
loki.write "local_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ==========================================
// 2. BESU PIPELINE 
// ==========================================
local.file_match "besu_files" {
  path_targets = [
    { "__path__" = "/var/log/besu/*.log", "job" = "besu" },
  ]
  sync_period = "10s"
}

// Process the JSON logs
loki.process "besu_pipeline" {
  forward_to = [loki.write.local_loki.receiver]

  // Extract fields from the Besu JSON log format
  stage.json {
    expressions = {
      timestamp = "timestamp",
      level     = "level",
      container = "container",
      message   = "message",
      class     = "class",
      thread    = "thread",
      throwable = "throwable",
    }
  }

  // Turn important fields into searchable labels
  stage.labels {
    values = {
      level     = "level",
      container = "container",
    }
  }

  // Use the timestamp from the log itself instead of the ingest time
  stage.timestamp {
    source = "timestamp"
    format = "RFC3339"
  }
  
  // Clean up the output: make the 'message' the main log line
  stage.output {
    source = "message"
  }
}

// Start the scrape
loki.source.file "besu_scraper" {
  targets    = local.file_match.besu_files.targets
  forward_to = [loki.process.besu_pipeline.receiver]
}

// ==========================================
// 3. NIMBUS PIPELINE 
// ==========================================
local.file_match "nimbus_files" {
  path_targets = [
    { "__path__" = "/var/log/nimbus/*.log", "job" = "nimbus" },
  ]
}

loki.process "nimbus_pipeline" {
  forward_to = [loki.write.local_loki.receiver]

  // Use regex to parse the text format since Nimbus isn't JSON
  stage.regex {
    expression = "^(?P<level>[A-Z]{3})\\s+(?P<timestamp>\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2}\\.\\d{3}[+-]\\d{2}:\\d{2})\\s+(?P<content>.*)$"
  }

  stage.labels {
    values = { level = "level" }
  }
  
  stage.output { source = "content" }
}

loki.source.file "nimbus_scraper" {
  targets    = local.file_match.nimbus_files.targets
  forward_to = [loki.process.nimbus_pipeline.receiver]
}

// ==========================================
// 4. PALADIN PIPELINE
// ==========================================

// Discover all containers whose name contains "paladin"
discovery.docker "paladin_containers" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "name"
    values = ["paladin"]
  }
}

// Strip the leading "/" Docker prepends to container names, expose as "node" label
discovery.relabel "paladin_targets" {
  targets = discovery.docker.paladin_containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.+)"
    target_label  = "node"
  }
}

// Parse JSON log lines and promote level to a searchable label
loki.process "paladin_pipeline" {
  forward_to = [loki.write.local_loki.receiver]

  stage.json {
    expressions = {
      level = "level",
      msg   = "msg",
    }
  }

  stage.labels {
    values = {
      level = "level",
    }
  }
}

loki.source.docker "paladin_scraper" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.paladin_targets.output
  forward_to = [loki.process.paladin_pipeline.receiver]
  labels     = { job = "paladin" }
}